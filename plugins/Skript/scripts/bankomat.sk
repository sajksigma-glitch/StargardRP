                    add 50 to player's balance
                    send "{@p} &aWpłacono 50$ na konto!" to player
                    set slot 40 of player's current inventory to book named "&6&lTwój stan konta" with lore "&7Posiadasz: &a%player's balance%$" and "" and "&eKliknij dolny rząd (hoppery), aby WPŁACIĆ."
                else:
                    send "{@p} &cNie masz tego przedmiotu przy sobie!" to player

        if clicked slot is 32:
            if {bankomat::item::100} is set:
                if player's inventory contains 1 of {bankomat::item::100}:
                    remove 1 of {bankomat::item::100} from player's inventory
                    add 100 to player's balance
                    send "{@p} &aWpłacono 100$ na konto!" to player
                    set slot 40 of player's current inventory to book named "&6&lTwój stan konta" with lore "&7Posiadasz: &a%player's balance%$" and "" and "&eKliknij dolny rząd (hoppery), aby WPŁACIĆ."
                else:
                    send "{@p} &cNie masz tego przedmiotu przy sobie!" to player

