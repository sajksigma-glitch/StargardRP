                        set slot 40 of player's current inventory to book named "&6&lTwój stan konta" with lore "&7Posiadasz: &a%player's balance%$" and "" and "&eKliknij dolny rząd (hoppery), aby WPŁACIĆ."
                    else:
                        send "{@p} &cNie masz miejsca w ekwipunku!" to player
                else:
                    send "{@p} &cMasz za mało pieniędzy!" to player

        if clicked slot is 15:
            if {bankomat::item::200} is set:
                if player's balance >= 200:
                    if player has enough space for 1 of {bankomat::item::200}:
                        remove 200 from player's balance
                        give 1 of {bankomat::item::200} to player
                        send "{@p} &aWypłacono 200$!" to player
                        set slot 40 of player's current inventory to book named "&6&lTwój stan konta" with lore "&7Posiadasz: &a%player's balance%$" and "" and "&eKliknij dolny rząd (hoppery), aby WPŁACIĆ."
                    else:
                        send "{@p} &cNie masz miejsca w ekwipunku!" to player
                else:
                    send "{@p} &cMasz za mało pieniędzy!" to player

        if clicked slot is 16:
            if {bankomat::item::500} is set:
                if player's balance >= 500:
                    if player has enough space for 1 of {bankomat::item::500}:
                        remove 500 from player's balance
                        give 1 of {bankomat::item::500} to player
                        send "{@p} &aWypłacono 500$!" to player
                        set slot 40 of player's current inventory to book named "&6&lTwój stan konta" with lore "&7Posiadasz: &a%player's balance%$" and "" and "&eKliknij dolny rząd (hoppery), aby WPŁACIĆ."
                    else:
                        send "{@p} &cNie masz miejsca w ekwipunku!" to player
                else:
                    send "{@p} &cMasz za mało pieniędzy!" to player

        # --- WPŁATY ---
        if clicked slot is 29:
            if {bankomat::item::10} is set:
                if player's inventory contains 1 of {bankomat::item::10}:
                    remove 1 of {bankomat::item::10} from player's inventory
                    add 10 to player's balance
                    send "{@p} &aWpłacono 10$ na konto!" to player
                    set slot 40 of player's current inventory to book named "&6&lTwój stan konta" with lore "&7Posiadasz: &a%player's balance%$" and "" and "&eKliknij dolny rząd (hoppery), aby WPŁACIĆ."
                else:
                    send "{@p} &cNie masz tego przedmiotu przy sobie!" to player

